#!/bin/sh
# post-checkout: after git worktree add, lists finished worktrees to remove (advice only). The
# rules are Susi Tools' (`susi-tools hook --help`); this file names only what this repository
# asks for.
susi-tools hook --help >/dev/null 2>&1 || { echo "[post-checkout] install the current susi-tools from Susi Tools' main: it runs this repository's hooks" >&2; exit 0; }
exec susi-tools hook post-checkout "$@"
