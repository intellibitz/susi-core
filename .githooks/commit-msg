#!/bin/sh
# commit-msg: the subject, the task trailer and its claim. The rules are Susi Tools'
# (`susi-tools hook --help`); this file names only what this repository asks for, and refuses
# when no installed susi-tools has them.
susi-tools hook --help >/dev/null 2>&1 || { echo "[commit-msg] install the current susi-tools from Susi Tools' main: it runs this repository's hooks" >&2; exit 1; }
exec susi-tools hook commit-msg "$1"
