#!/bin/sh
# run-susi <subcommand> <verb> [args...]: run `<bin> <subcommand> <verb> ...` for a
# hook, with the first binary that has that verb: $SUSI_WORKFLOW_BIN (the binary
# driving a `workflow finish`), then `susi-tools` on PATH (the Susi development
# tool, where `workflow` and `tasks` live). Nothing else is asked: since
# 2026-11-22 no other program carries these verbs, and an older build that still
# does must not enforce rules nobody maintains. A binary without the verb is
# passed over, not run into. Nothing here needs more than sh and git.
#
# No check is skipped silently. The workflow guard is the agent workflow's own
# rule set, not this open repository's: with no binary that has `workflow guard`,
# the hook says in one line that the Susi development tool is not installed,
# applies the commit and merge rules it can judge itself, and refuses every
# other stage (it fails closed, so an unguarded commit never slips through).
# The gated landing (`cargo local-workflow`) never runs these hooks and judges
# every change itself.
set -u
top=$(git rev-parse --show-toplevel 2>/dev/null) || top=$(cd "$(dirname "$0")/.." && pwd)
for bin in "${SUSI_WORKFLOW_BIN:-}" "$(command -v susi-tools 2>/dev/null)"; do
    [ -n "$bin" ] && [ -x "$bin" ] || continue
    if "$bin" "$1" "$2" --help >/dev/null 2>&1 </dev/null; then
        exec "$bin" "$@"
    fi
done
if [ "$1 $2" = "workflow guard" ]; then
    shift 2
    for bin in "${SUSI_WORKFLOW_BIN:-}" "$(command -v susi-tools 2>/dev/null)"; do
        [ -n "$bin" ] && [ -x "$bin" ] || continue
        if "$bin" board guard --help >/dev/null 2>&1 </dev/null; then
            exec "$bin" board guard "$@"
        fi
    done
    echo "[workflow-guard] no program here answers \`susi-tools workflow guard\`. Only the built-in commit and merge rules run; install the current susi-tools from Susi Tools' main." >&2
    if [ "$#" -ge 1 ]; then
        stage=$1
        git_dir=$(git rev-parse --path-format=absolute --git-dir 2>/dev/null) || exit 1
        common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 1
        case "$stage" in
        commit)
            if [ "$git_dir" = "$common_dir" ] && [ "${SUSI_ALLOW_PRIMARY:-0}" != "1" ]; then
                echo "❌ workflow guard: refusing commit in the primary checkout; use a linked worktree (SUSI_ALLOW_PRIMARY=1 to override)." >&2
                exit 1
            fi
            branch=$(git symbolic-ref -q --short HEAD 2>/dev/null || true)
            if [ "$branch" = "main" ] && [ ! -f "$git_dir/MERGE_HEAD" ] && [ "${SUSI_ALLOW_MAIN:-0}" != "1" ]; then
                echo "❌ workflow guard: refusing plain commit directly on main; use a feature branch in a linked worktree (SUSI_ALLOW_MAIN=1 to override)." >&2
                exit 1
            fi
            exit 0
            ;;
        merge)
            if [ "$git_dir" = "$common_dir" ] && [ "${SUSI_ALLOW_PRIMARY:-0}" != "1" ]; then
                echo "❌ workflow guard: refusing merge in the primary checkout; use a linked worktree (SUSI_ALLOW_PRIMARY=1 to override)." >&2
                exit 1
            fi
            exit 0
            ;;
        esac
    fi
    echo "❌ workflow guard failed closed: the built-in rules cover commit and merge only, and nothing here answers \`workflow guard\` or \`susi board guard\` for this stage." >&2
    exit 1
fi
echo "❌ no program here answers \`susi-tools $1 $2\` (looked at SUSI_WORKFLOW_BIN and susi-tools on PATH). Install the current susi-tools from Susi Tools' main." >&2
exit 1
