#!/bin/sh
# pre-commit: the agent's own root, a fresh checkout and the staged change, in a linked worktree
# (Mandate 49). The rules are Susi Tools' (`susi-tools hook --help`); this file names only what
# this repository asks for, and refuses when no installed susi-tools has them.
susi-tools hook --help >/dev/null 2>&1 || { echo "[pre-commit] install the current susi-tools from Susi Tools' main: it runs this repository's hooks" >&2; exit 1; }
exec susi-tools hook pre-commit --worktrees
